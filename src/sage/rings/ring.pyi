from typing import Any, Optional, Union, Iterator, TypeVar
from sage.structure.parent_gens import ParentWithGens
from sage.categories.category import Category

# Type aliases for Sage number types
T = TypeVar('T')
SageElement = Union['sage.structure.element.Element', Any]  # Will be refined later
SageRing = Union['Ring', Any]  # Will be refined later 
SageInteger = Union['sage.rings.integer.Integer', int]
SageRational = Union['sage.rings.rational.Rational', 'SageInteger'] 
SageNumber = Union['SageRational', float, complex]

class Ring(ParentWithGens):
    """Generic ring class."""
    
    def __init__(self, base: Optional[SageRing] = None, names: Optional[Any] = None, 
                 normalize: bool = True, category: Optional[Category] = None) -> None:
        ...
    
    def __iter__(self) -> Iterator[SageElement]:
        """Return an iterator through the elements of this ring."""
        ...
    
    def __len__(self) -> int:
        """Return the cardinality of this ring if finite."""
        ...
    
    def __xor__(self, n: Any) -> Any:
        """Trap the operation ^."""
        ...
    
    def base_extend(self, R: SageRing) -> SageRing:
        """Extend the base ring."""
        ...
    
    def category(self) -> Category:
        """Return the category to which this ring belongs."""
        ...
    
    def __mul__(self, x: Any) -> Any:
        """Return the ideal x*R generated by x."""
        ...
    
    def zero(self) -> SageElement:
        """Return the zero element of this ring."""
        ...
    
    def one(self) -> SageElement:
        """Return the one element of this ring."""
        ...
    
    def order(self) -> Union[SageInteger, Any]:
        """Return the order (cardinality) of this ring."""
        ...

class CommutativeRing(Ring):
    """Commutative ring class."""
    
    def __init__(self, base_ring: Optional[SageRing] = None, names: Optional[Any] = None, 
                 normalize: bool = True, category: Optional[Category] = None) -> None:
        ...
    
    def fraction_field(self) -> SageRing:
        """Return the fraction field of this ring."""
        ...
    
    def extension(self, poly: Any, name: Optional[str] = None, names: Optional[Any] = None, 
                  **kwds: Any) -> SageRing:
        """Return an extension of this ring."""
        ...

class IntegralDomain(CommutativeRing):
